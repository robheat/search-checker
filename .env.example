# Copy to .env (or just use the in-app Settings screen — it saves to data/settings.json).

# Option A: Webshare API key (dashboard → API → Keys). Username/password are fetched automatically.
WEBSHARE_API_KEY=

# Option B: proxy username & password (dashboard → Proxy → Residential → rotating endpoint).
# Use the BASE username, without "-rotate" or a country suffix.
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Rotating endpoint (defaults shown).
# WEBSHARE_PROXY_HOST=p.webshare.io
# WEBSHARE_PROXY_PORT=80

# Username formats. {user}, {country} (e.g. US) and {session}; [ ... ] is dropped when empty.
# Change these if your Webshare dashboard shows a different format for country targeting / sticky IPs.
# WEBSHARE_ROTATE_TEMPLATE={user}[-{country}]-rotate
# WEBSHARE_STICKY_TEMPLATE={user}[-{country}]-{session}

# App
# HOST=127.0.0.1          # use 0.0.0.0 to expose on your network (then set APP_PASSWORD!)
# PORT=3000
# APP_PASSWORD=           # enables HTTP basic auth (any username, this password)
# MAX_CONCURRENT=3        # parallel browser sessions
# NAV_TIMEOUT_MS=45000
# MAX_HISTORY=200         # saved views kept on disk
# CHROMIUM_PATH=          # use a specific Chromium/Chrome binary
# IP_LOOKUP_URLS=https://ipinfo.io/json,https://api.ipify.org?format=json
